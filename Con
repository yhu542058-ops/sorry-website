<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To My Only Love... 💖</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Poppins:wght@300;400;500&display=swap');

        body {
            margin: 0;
            padding: 0;
            background: radial-gradient(circle at center, #1f1124 0%, #0b060d 100%);
            font-family: 'Poppins', sans-serif;
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
            text-align: center;
        }
        .container {
            max-width: 380px;
            width: 90%;
            padding: 40px 25px;
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 107, 129, 0.25);
            border-radius: 35px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8), 0 0 25px rgba(255, 107, 129, 0.15);
            animation: cardAppear 0.5s ease-in-out;
        }
        @keyframes cardAppear {
            from { opacity: 0; transform: translateY(15px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .glow-heart {
            font-size: 55px;
            margin-bottom: 15px;
            animation: pulse 2s infinite;
            display: inline-block;
        }
        @keyframes pulse {
            0% { transform: scale(1); filter: drop-shadow(0 0 10px rgba(255, 107, 129, 0.8)); }
            50% { transform: scale(1.15); filter: drop-shadow(0 0 30px rgba(255, 107, 129, 1)); }
            100% { transform: scale(1); filter: drop-shadow(0 0 10px rgba(255, 107, 129, 0.8)); }
        }
        .step-indicator {
            font-size: 11px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #ff94a2;
            margin-bottom: 12px;
            font-weight: 500;
        }
        h1 {
            font-family: 'Playfair Display', serif;
            color: #ff6b81;
            font-size: 24px;
            margin-bottom: 15px;
            font-weight: 600;
        }
        p {
            font-size: 14.5px;
            color: #f0f0f0;
            line-height: 1.8;
            margin-bottom: 35px;
            font-weight: 300;
        }
        .btn {
            background: linear-gradient(135deg, #ff4757, #ff6b81);
            color: white;
            border: none;
            padding: 13px 30px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(255, 71, 87, 0.5);
            transition: all 0.3s ease;
        }
        .btn:active { transform: scale(0.95); }
        .btn-secondary {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: none;
        }
        .btn-group {
            display: flex;
            gap: 12px;
            justify-content: center;
        }
    </style>
</head>
<body>

    <div class="container" id="mainCard">
        <div class="step-indicator" id="stepIndicator">Page 1 of 7</div>
        <span class="glow-heart" id="cardEmoji">❤️‍🔥</span>
        <h1 id="cardTitle">My heart only beats for you...</h1>
        <p id="messageText">I couldn't sleep tonight knowing we aren't okay. You are my entire world, and I need you to read this straight from my soul.</p>
        <div class="btn-group" id="btnGroup">
            <button class="btn" onclick="nextStep()">Open My Heart 💌</button>
        </div>
    </div>

    <script>
        let step = 1;
        function nextStep() {
            const indicator = document.getElementById("stepIndicator");
            const emoji = document.getElementById("cardEmoji");
            const title = document.getElementById("cardTitle");
            const text = document.getElementById("messageText");
            const btnGroup = document.getElementById("btnGroup");

            if (step === 1) {
                indicator.innerHTML = "Page 2 of 7";
                emoji.innerHTML = "🥺";
                title.innerHTML = "I hate that I made you cry";
                text.innerHTML = "The thought of causing pain to the most precious person in my life destroys me inside. Your smile is my sunshine, and seeing you hurt is my biggest failure.";
                step++;
            } else if (step === 2) {
                indicator.innerHTML = "Page 3 of 7";
                emoji.innerHTML = "🥀";
                title.innerHTML = "My days are gray without you";
                text.innerHTML = "Everything around me feels empty when we fight. I keep staring at our chat, wishing I could turn back time, erase my mistakes, and hold you close instead.";
                step++;
            } else if (step === 3) {
                indicator.innerHTML = "Page 4 of 7";
                emoji.innerHTML = "🕊️";
                title.innerHTML = "You are my ultimate peace";
                text.innerHTML = "In a chaotic world, you are my only safe haven. Hurting my safe place feels like tearing a piece of my own soul away. I never want to feel this distance again.";
                step++;
            } else if (step === 4) {
                indicator.innerHTML = "Page 5 of 7";
                emoji.innerHTML = "🌹";
                title.innerHTML = "No excuses, just my promise";
                text.innerHTML = "I won't try to defend what I did. I own my mistakes completely. I promise to listen closer, love you deeper, and treat you like the absolute queen you are every single day.";
                step++;
            } else if (step === 5) {
                indicator.innerHTML = "Page 6 of 7";
                emoji.innerHTML = "⏳";
                title.innerHTML = "I will wait for you forever";
                text.innerHTML = "Even if your heart needs time to heal and trust me again, I am not going anywhere. I will prove my love to you with every breath I take.";
                step++;
            } else if (step === 6) {
                indicator.innerHTML = "Page 7 of 7";
                emoji.innerHTML = "💖";
                title.innerHTML = "Can you forgive me, my love?";
                text.innerHTML = "Will you let me wrap my arms around you, wipe away your tears, and make everything right again? What does your beautiful heart say?";
                
                btnGroup.innerHTML = `
                    <button class="btn" onclick="finalYes()">Yes, I forgive you ❤️</button>
                    <button class="btn btn-secondary" onclick="finalNo()">Still mad 😤</button>
                `;
                step++;
            }
        }

        function finalYes() {
            document.getElementById("stepIndicator").innerHTML = "Forever Yours ✨";
            document.getElementById("cardEmoji").innerHTML = "🥰";
            document.getElementById("cardTitle").innerHTML = "You just made me the happiest!";
            document.getElementById("messageText").innerHTML = "Thank you for having such a golden, forgiving heart, my love. I promise I will cherish you endlessly and never let you down again. I love you infinitely!";
            document.getElementById("btnGroup").innerHTML = `<button class="btn" onclick="location.reload()">Replay Message 💖</button>`;
        }

        let clickCount = 0;
        function finalNo() {
            clickCount++;
            let title = document.getElementById("cardTitle");
            let text = document.getElementById("messageText");
            let emoji = document.getElementById("cardEmoji");

            if (clickCount === 1) {
                emoji.innerHTML = "💔";
                title.innerHTML = "Ouch, my heart... 🥺";
                text.innerHTML = "I know I messed up and healing takes time, but please don't shut me out. I miss you more than words can express.";
            } else if (clickCount === 2) {
                emoji.innerHTML = "✨";
                title.innerHTML = "I'm not giving up on us";
                text.innerHTML = "Even if you're still upset, my love for you is absolute. I'll stay right here waiting until your heart is ready to smile at me again.";
            } else {
                emoji.innerHTML = "🥺💖";
                title.innerHTML = "Pretty please, my everything?";
                text.innerHTML = "You're far too special to stay angry at me forever! Tap 'Yes, I forgive you' and let's fall back into each other's arms!";
            }
        }
    </script>
</body>
</html>
